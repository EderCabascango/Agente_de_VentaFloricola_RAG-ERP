# Copia este archivo a .env y completa tus claves. .env NO se sube a git.

# Proveedor de LLM: groq (principal) | gemini (respaldo) | ollama (sin internet) | azure (producción)
LLM_PROVIDER=groq
# Si el proveedor principal falla (503/429/timeout), la misma llamada se reintenta en este. Vacío = sin respaldo.
LLM_FALLBACK_PROVIDER=gemini

# --- Gemini (Google AI Studio, gratis: https://aistudio.google.com/apikey) ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=low

# --- Groq (gratis: https://console.groq.com/keys) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Ollama (local, sin internet: ollama pull qwen2.5:7b) ---
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# --- Azure OpenAI (opción de producción, no requerida para la demo) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
OPENAI_API_VERSION=2024-10-21

# --- Embeddings locales (gratis, sin API) ---
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Límites del agente ---
MAX_ITERACIONES=6

# --- Canal WhatsApp (Cloud API de Meta). Guía: docs/whatsapp_produccion.md ---
# Token de acceso (permanente: usuario del sistema en Meta Business) y el Phone number ID del número del bot
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Texto que inventas tú y repites en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=
# App Secret de la app de Meta (Configuración de la app > Básica): verifica que los mensajes vienen de Meta
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v24.0
# Números (con código de país) que aprueban pedidos con botones. Separados por coma.
WHATSAPP_SUPERVISORES=
# Testers del piloto: número=ID de cliente del ERP sintético. Ej: +593991112233=C001,+593987776655=C003
WHATSAPP_CLIENTES=
# Cliente del ERP para números no registrados (vacío = se les pide esperar a un asesor). Ej: C001
WHATSAPP_CLIENTE_POR_DEFECTO=
# Número desconocido: 1 = se registra solo como cliente nuevo y se le atiende (recomendado); 0 = espera a un asesor
WHATSAPP_REGISTRAR_NUEVOS=1
# Mensajes por minuto y por número (0 = sin tope). Protege la cuota del LLM al atender a cualquiera
WHATSAPP_MAX_MENSAJES_MINUTO=15
# Condiciones de un cliente nuevo registrado por WhatsApp
CLIENTE_NUEVO_LIMITE_CREDITO=2000
CLIENTE_NUEVO_DESCUENTO_MAX=0
